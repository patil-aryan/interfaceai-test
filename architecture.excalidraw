      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "id / version / risk tier / approved?\ntyped inputs + outputs\nsteps: locator chain, checkpoint, failure policy\nsuccess condition\nbusiness outcomes + how to spot them\nprovenance: which model, which run, which tenant\n\njust JSON. someone reads it, diffs it, approves it.\na model writing python = nobody can review it",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "art",
      "originalText": "id / version / risk tier / approved?\ntyped inputs + outputs\nsteps: locator chain, checkpoint, failure policy\nsuccess condition\nbusiness outcomes + how to spot them\nprovenance: which model, which run, which tenant\n\njust JSON. someone reads it, diffs it, approves it.\na model writing python = nobody can review it",
      "autoResize": true,
      "lineHeight": 1.25
    },
