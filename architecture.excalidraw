      "versionNonce": 134913211,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "walk the artifact:\n  policy check -> resolve target (try each way in turn)\n  -> act -> wait for it to settle -> assert checkpoint\n  -> log. note if a weaker locator had to be used",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r1",
      "originalText": "walk the artifact:\n  policy check -> resolve target (try each way in turn)\n  -> act -> wait for it to settle -> assert checkpoint\n  -> log. note if a weaker locator had to be used",
      "autoResize": true,
      "lineHeight": 1.25
    },
