# Copy to .env and fill in. Never commit .env.

# Required only for discovery runs (the LLM-driven path).
# Deterministic replay runs without it.
ANTHROPIC_API_KEY=

# Credentials for the target application's operator account.
# Resolved at replay time by the secret provider; never enter the model's
# context, the artifact, or the event log.
TARGET_APP_USERNAME=operator1
TARGET_APP_PASSWORD=changeme

# Where the fake core banking app is served.
TARGET_APP_BASE_URL=http://localhost:8081
